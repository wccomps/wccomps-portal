# Copy to .env and fill in. docker compose reads .env for the variables docker-compose.yml uses and passes it to
# every service (the chat process without the Proxmox, aweful-proxy and SMTP secrets); a plain run loads it into the
# shell (`set -a; . ./.env; set +a`). docs/self-hosting.md "Settings reference" gives each setting's default and
# meaning. A commented line shows a setting's default; uncomment it only to change it (an empty value is not always
# the default).

# ---------------------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------------------
ORG_NAME="Example Cyber League"
ORG_SHORT_NAME=ECL

# At least 50 random characters; the web server, the worker and the chat process refuse a shorter or plainer one.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your_random_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,portal.example.org
BASE_URL=https://portal.example.org

# Authentik; setup in docs/self-hosting.md "Authentik". Every service URL below that carries a credential (Authentik,
# Quotient, Proxmox, Nextcloud, aweful-proxy) must be https, or the processes refuse to start.
AUTHENTIK_URL=https://auth.example.org
AUTHENTIK_OIDC_URL=https://auth.example.org/application/o/discord-bot/
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_SECRET=your_oauth_client_secret
AUTHENTIK_TOKEN=your_authentik_api_token

DEFAULT_FROM_EMAIL=noreply@example.org

# Database. docker compose sets DB_HOST and DB_PORT for its own Postgres, which refuses to start until DB_PASSWORD is
# set; for a plain run, set DB_HOST=localhost.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wccomps
DB_USER=wccomps
DB_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------------------------------

# Web server; behind a proxy other than Cloudflare, see docs/self-hosting.md "The reverse proxy". Yes/no settings take
# true/false, yes/no, on/off or 1/0, in any case; anything else stops the processes.
DJANGO_DEBUG=false
TRUST_CF_CONNECTING_IP=false
# Published on localhost only, for a reverse proxy on this host; publish it wider (8000) only on purpose
WEB_PORT=127.0.0.1:8000
# PORTAL_TAG=main
GUNICORN_WORKERS=4

# Email; the console backend prints mail, team passwords included, to the log and sends nothing
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=noreply@example.org
EMAIL_HOST_PASSWORD=your_email_password
# DEFAULT_REPLY_TO_EMAIL=
# SERVER_EMAIL=noreply@example.org

# Quotient; the login is an [[admin]] account from Quotient's event.conf
QUOTIENT_API_URL=
QUOTIENT_USERNAME=
QUOTIENT_PASSWORD=

# Proxmox VE; the token is user@realm!tokenid=secret, privileges in docs/self-hosting.md "Proxmox"
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
PROXMOX_CA_FILE=
PROXMOX_VERIFY_SSL=true
PROXMOX_DEFAULT_SNAPSHOT=clean
BOX_RESET_CATEGORY_ID=2

# aweful-proxy
AWEFUL_PROXY_URL=
AWEFUL_PROXY_TOKEN=

# Service URL settings (comma-separated) allowed to be plain http, for a service on a network nobody else can read (an
# in-cluster address). Empty: all https.
ALLOW_HTTP_URLS=

# Nextcloud; the login is a Nextcloud admin
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_OIDC_PROVIDER_ID=1

# Timeouts in seconds
HTTPX_DEFAULT_TIMEOUT=10
DISCORD_WEBHOOK_TIMEOUT=5

# Error alerts (a Discord channel webhook, https only); works without the Discord bot
DISCORD_ERROR_WEBHOOK_URL=

# Heartbeats; for a plain run, set a writable directory
# BOT_HEARTBEAT_DIR=/app/run/heartbeat

# ---------------------------------------------------------------------------------------------------------------------
# Discord; setup in docs/self-hosting.md "Discord"
# ---------------------------------------------------------------------------------------------------------------------
# Any value configures Discord, so leave it empty for Zulip only
DISCORD_BOT_TOKEN=
# IDs: 0 = not configured. With one server, set VOLUNTEER_GUILD_ID to the DISCORD_GUILD_ID value.
DISCORD_GUILD_ID=0
VOLUNTEER_GUILD_ID=0
DISCORD_LOG_CHANNEL_ID=0
DISCORD_TICKET_QUEUE_CHANNEL_ID=0
DISCORD_ANNOUNCEMENT_CHANNEL_ID=0
DISCORD_WELCOME_CHANNEL_ID=0
DISCORD_LINK_CHANNEL_ID=0
BLUETEAM_ROLE_ID=0
BLACKTEAM_ROLE_ID=0
WHITETEAM_ROLE_ID=0
ORANGETEAM_ROLE_ID=0
REDTEAM_ROLE_ID=0
GOLDTEAM_ROLE_ID=0
DISCORD_SERVER_OWNER_ROLE="ECL Server Owners"
SYNC_COMMANDS=

# ---------------------------------------------------------------------------------------------------------------------
# Zulip; setup in docs/self-hosting.md "Zulip"
# ---------------------------------------------------------------------------------------------------------------------
# All three configure Zulip (https only)
ZULIP_SITE=
ZULIP_BOT_EMAIL=
ZULIP_API_KEY=
ZULIP_TEAM_STREAM=team{number:02d}
# A broadcast to teams: each team's own stream (empty: ZULIP_TEAM_STREAM) and topic (empty: announcements), such as
# "Team {number:02d} Chat" and automation-messages
ZULIP_TEAM_BROADCAST_STREAM=
ZULIP_TEAM_BROADCAST_TOPIC=announcements
# Empty: no separate staff notice; a new ticket's post in its team's stream (with ZULIP_STAFF_MENTION) is the only one
ZULIP_STAFF_STREAM=tickets
ZULIP_ANNOUNCEMENTS_STREAM=announcements
ZULIP_OPS_STREAM=ops
ZULIP_OPS_TOPIC=ops
ZULIP_TEAM_MENTION=
ZULIP_STAFF_MENTION=

# ---------------------------------------------------------------------------------------------------------------------
# Region names
# ---------------------------------------------------------------------------------------------------------------------
SITE_NAME="ECL Portal"
PORTAL_GROUP_PREFIX=Portal_
PORTAL_ADMIN_GROUP=Portal_Admin
# Each role's group, by default (unset or empty) PORTAL_GROUP_PREFIX plus a fixed suffix; a name may contain spaces
# ("Black Team"), and no two roles may share one. See docs/self-hosting.md "Permission groups"
# PORTAL_GOLD_GROUP=Portal_GoldTeam
# PORTAL_WHITE_GROUP=Portal_WhiteTeam
# PORTAL_WHITE_LEAD_GROUP=Portal_WhiteTeam_Lead
# PORTAL_ORANGE_GROUP=Portal_OrangeTeam
# PORTAL_ORANGE_LEAD_GROUP=Portal_OrangeTeam_Lead
# PORTAL_RED_GROUP=Portal_RedTeam
# PORTAL_BLACK_GROUP=Portal_BlackTeam
# PORTAL_TICKETING_ADMIN_GROUP=Portal_Ticketing_Admin
# PORTAL_TICKETING_SUPPORT_GROUP=Portal_Ticketing_Support
# {number} patterns; see docs/self-hosting.md "Teams and team accounts"
# TEAM_GROUP_PATTERN=Portal_BlueTeam{number:02d}
TEAM_ACCOUNT_PATTERN=team{number}
# Authentik user folder of the team accounts (such as blue-users) when there are no team groups; empty uses the team
# groups. See docs/self-hosting.md "Teams without Authentik groups (team folder)"
TEAM_ACCOUNT_PATH=
MAX_TEAMS=50
