# Required: the web server, the worker and the chat process refuse to start while any of AUTHENTIK_URL,
# DEFAULT_FROM_EMAIL, ORG_NAME or ORG_SHORT_NAME is empty (web/portal/required.py). The rest default to off or a
# neutral value.

# Your organization's names: ORG_NAME signs packet emails, ORG_SHORT_NAME heads email subjects and scorecards
ORG_NAME=Example Cyber League
ORG_SHORT_NAME=ECL
# Page titles; defaults to "<ORG_SHORT_NAME> Portal"
SITE_NAME=ECL Portal

# Discord Bot Configuration (the chat process, `docker compose --profile chat up`, runs the bot when this is set)
DISCORD_BOT_TOKEN=your_bot_token_here
# Discord IDs (right-click > Copy ID with Developer Mode on). Each must be a number; 0 means not
# configured, which turns off whatever needs it (the bot logs which ones are unset at startup).
# Competition server, where roles are synced to
DISCORD_GUILD_ID=0
DISCORD_LOG_CHANNEL_ID=0
DISCORD_TICKET_QUEUE_CHANNEL_ID=0
DISCORD_ANNOUNCEMENT_CHANNEL_ID=0
# Webhook for 500 error alerts (Discord channel settings > Integrations > Webhooks); empty = off
DISCORD_ERROR_WEBHOOK_URL=
# Authentik group to Discord role mappings
BLUETEAM_ROLE_ID=0
BLACKTEAM_ROLE_ID=0
WHITETEAM_ROLE_ID=0
ORANGETEAM_ROLE_ID=0
REDTEAM_ROLE_ID=0
GOLDTEAM_ROLE_ID=0

# VOLUNTEER_GUILD_ID is the volunteer Discord server, where staff can only /link their accounts.
# Roles live in the competition server (DISCORD_GUILD_ID above) and come from Authentik groups.
VOLUNTEER_GUILD_ID=0

# Authentik OAuth Configuration
AUTHENTIK_URL=https://auth.example.org
# Defaults to AUTHENTIK_URL/application/o/discord-bot/
AUTHENTIK_OIDC_URL=https://auth.example.org/application/o/discord-bot/
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_SECRET=your_oauth_client_secret
AUTHENTIK_TOKEN=your_authentik_api_token
# Permissions come from Authentik groups (web/core/permission_constants.py PERMISSION_MAP): PORTAL_ADMIN_GROUP
# (everything), and PORTAL_GROUP_PREFIX plus GoldTeam, WhiteTeam, WhiteTeam_Lead, OrangeTeam, OrangeTeam_Lead, RedTeam,
# Ticketing_Admin and Ticketing_Support; PORTAL_GROUP_PREFIX plus BlackTeam only grants its Discord role (settings.py
# GROUP_ROLE_MAPPING). An active team's group is TEAM_GROUP_PATTERN (Portal_BlueTeamNN) unless the team names another.
PORTAL_GROUP_PREFIX=Portal_
PORTAL_ADMIN_GROUP=Portal_Admin

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wccomps
DB_USER=wccomps
DB_PASSWORD=your_secure_password_here

# Django Configuration
DJANGO_SECRET_KEY=your_random_secret_key_here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,portal.example.org
BASE_URL=https://portal.example.org
# True only when every request reaches the app through Cloudflare, which sets CF-Connecting-IP (clients can forge it)
TRUST_CF_CONNECTING_IP=False

# Web Server Configuration
WEB_PORT=8000
# Gunicorn workers (default 4). Each keeps one database connection open, plus one per thread
# while packets are being emailed; keep workers x web replicas well under Postgres max_connections.
GUNICORN_WORKERS=4

# Quotient Scoring Engine Integration
QUOTIENT_API_URL=https://scoring.example.org
QUOTIENT_USERNAME=quotient_admin
QUOTIENT_PASSWORD=your_quotient_password_here

# Proxmox VE Integration (for box resets from tickets)
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
PROXMOX_CA_FILE=
PROXMOX_VERIFY_SSL=True
PROXMOX_DEFAULT_SNAPSHOT=clean

# Email Configuration (for team packet distribution)
# Email backend: django.core.mail.backends.smtp.EmailBackend (production) or
#                django.core.mail.backends.console.EmailBackend (development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@example.org
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@example.org
# Reply-To on packet emails; empty sends none
DEFAULT_REPLY_TO_EMAIL=info@example.org
