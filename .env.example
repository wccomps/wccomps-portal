# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
# Discord IDs (right-click > Copy ID with Developer Mode on). Each must be a number; 0 means not
# configured, which turns off whatever needs it (the bot logs which ones are unset at startup).
# Competition server, where roles are synced to
DISCORD_GUILD_ID=0
DISCORD_LOG_CHANNEL_ID=0
DISCORD_TICKET_QUEUE_CHANNEL_ID=0
DISCORD_ANNOUNCEMENT_CHANNEL_ID=0
# Webhook for 500 error alerts (Discord channel settings > Integrations > Webhooks); empty = off
DISCORD_ERROR_WEBHOOK_URL=
# Authentik group to Discord role mappings
BLUETEAM_ROLE_ID=0
BLACKTEAM_ROLE_ID=0
WHITETEAM_ROLE_ID=0
ORANGETEAM_ROLE_ID=0
REDTEAM_ROLE_ID=0
GOLDTEAM_ROLE_ID=0

# VOLUNTEER_GUILD_ID is the volunteer Discord server, where staff can only /link their accounts.
# Roles live in the competition server (DISCORD_GUILD_ID above) and come from Authentik groups.
VOLUNTEER_GUILD_ID=0

# Authentik OAuth Configuration
AUTHENTIK_URL=https://auth.wccomps.org
AUTHENTIK_OIDC_URL=https://auth.wccomps.org/application/o/discord-bot/
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_SECRET=your_oauth_client_secret
AUTHENTIK_TOKEN=your_authentik_api_token
# Permissions come from Authentik groups (web/core/permission_constants.py PERMISSION_MAP), e.g.
# WCComps_BlueTeamNN (team), WCComps_Discord_Admin (everything), WCComps_GoldTeam, WCComps_WhiteTeam,
# WCComps_OrangeTeam, WCComps_RedTeam, WCComps_Ticketing_Admin, WCComps_Ticketing_Support.

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wccomps
DB_USER=wccomps
DB_PASSWORD=your_secure_password_here

# Django Configuration
DJANGO_SECRET_KEY=your_random_secret_key_here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,portal.wccomps.org
BASE_URL=https://portal.wccomps.org

# Web Server Configuration
WEB_PORT=8000
# Gunicorn workers (default 4). Each keeps one database connection open, plus one per thread
# while packets are being emailed; keep workers x web replicas well under Postgres max_connections.
GUNICORN_WORKERS=4

# Quotient Scoring Engine Integration
QUOTIENT_API_URL=https://scoring.wccomps.org
QUOTIENT_USERNAME=wccomps_admin
QUOTIENT_PASSWORD=your_quotient_password_here

# Proxmox VE Integration (for box resets from tickets)
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
PROXMOX_VERIFY_SSL=True
PROXMOX_DEFAULT_SNAPSHOT=clean

# Email Configuration (for team packet distribution)
# Email backend: django.core.mail.backends.smtp.EmailBackend (production) or
#                django.core.mail.backends.console.EmailBackend (development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@wccomps.org
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@wccomps.org
