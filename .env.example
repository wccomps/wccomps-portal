# Copy to .env and fill in. docker compose reads .env for the variables docker-compose.yml uses and passes it to
# every service; a plain run loads it into the shell (`set -a; . ./.env; set +a`). docs/self-hosting.md describes each
# setting. A commented line shows a setting's default; uncomment it only to change it (an empty value is not the
# default).

# ---------------------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------------------
# The web server, the worker and the chat process refuse to start while any of AUTHENTIK_URL, DEFAULT_FROM_EMAIL,
# ORG_NAME or ORG_SHORT_NAME is empty (web/portal/required.py); the web server also refuses without
# DJANGO_SECRET_KEY. A deployment needs the rest of this group too: unset, they suit only a developer's machine, or
# leave sign-in and the Authentik features off.

# Your organization's names: ORG_NAME signs packet emails, ORG_SHORT_NAME heads email subjects and scorecards
ORG_NAME="Example Cyber League"
ORG_SHORT_NAME=ECL

# Signs sessions, CSRF tokens and OAuth state. Generate one:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your_random_secret_key_here
# Host names the portal answers to, comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1,portal.example.org
# The portal's public address; an https one is also CSRF's trusted origin. Default http://localhost:5000
BASE_URL=https://portal.example.org

# Authentik: the server, the OAuth2/OpenID provider the portal signs in with, and an API token
AUTHENTIK_URL=https://auth.example.org
# The provider's OpenID base, https://<authentik>/application/o/<application slug>/; defaults to
# AUTHENTIK_URL/application/o/discord-bot/
AUTHENTIK_OIDC_URL=https://auth.example.org/application/o/discord-bot/
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_SECRET=your_oauth_client_secret
AUTHENTIK_TOKEN=your_authentik_api_token

# From address of packet and scorecard emails
DEFAULT_FROM_EMAIL=noreply@example.org

# Database. docker compose points web, the worker and chat at its own Postgres (DB_HOST and DB_PORT are set there) and
# creates it with DB_NAME, DB_USER and DB_PASSWORD; for a plain run, set DB_HOST=localhost.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wccomps
DB_USER=wccomps
DB_PASSWORD=your_secure_password_here

# ---------------------------------------------------------------------------------------------------------------------
# Optional: each of these turns a feature on, or tunes one, and defaults to off or a working value
# ---------------------------------------------------------------------------------------------------------------------

# Web server
DJANGO_DEBUG=False
# True only when every request reaches the app through Cloudflare, which sets CF-Connecting-IP (clients can forge it)
TRUST_CF_CONNECTING_IP=False
# Port docker compose publishes the web app on
WEB_PORT=8000
# Image tag docker compose runs (ghcr.io/wccomps/wccomps-portal)
# PORTAL_TAG=main
# Gunicorn workers (default 4). Each keeps one database connection open, plus one per thread
# while packets are being emailed; keep workers x web replicas well under Postgres max_connections.
GUNICORN_WORKERS=4

# Email (packet and scorecard distribution). The default backend is SMTP with the EMAIL_* settings below;
# django.core.mail.backends.console.EmailBackend prints each message to the log instead and ignores them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@example.org
EMAIL_HOST_PASSWORD=your_email_password
# Reply-To on packet emails; empty sends none
DEFAULT_REPLY_TO_EMAIL=info@example.org
# Django's own error mail sender; defaults to DEFAULT_FROM_EMAIL. The portal configures no ADMINS, so none is sent.
# SERVER_EMAIL=noreply@example.org

# Quotient scoring engine: inject titles and grading, service scores, box lists, ticket service checks. Empty = off.
# The login is an [[admin]] account from Quotient's event.conf.
QUOTIENT_API_URL=
QUOTIENT_USERNAME=
QUOTIENT_PASSWORD=

# Proxmox VE: box resets from tickets, and unscored boxes in the box lists. Empty = off.
# PROXMOX_API_URL takes several hosts, comma-separated; PROXMOX_API_TOKEN is user@realm!tokenid=secret.
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
# CA certificate file for the Proxmox hosts (their cluster CA); empty uses the system's
PROXMOX_CA_FILE=
PROXMOX_VERIFY_SSL=True
# Snapshot a box reset offers first, when the VM has it
PROXMOX_DEFAULT_SNAPSHOT=clean
# The ticket category whose tickets offer the box reset (seeded as "Box Reset / Scrub")
BOX_RESET_CATEGORY_ID=2

# aweful-proxy: each Quotient metadata sync posts the team network layout to AWEFUL_PROXY_URL/config. Empty = off.
AWEFUL_PROXY_URL=
# Sent as a Bearer token when set
AWEFUL_PROXY_TOKEN=

# Nextcloud: a team account per team through the user_oidc app, made at the competition start and removed at Close Out.
# Empty = off. The login is a Nextcloud admin; NEXTCLOUD_OIDC_PROVIDER_ID is the user_oidc provider's numeric id.
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_OIDC_PROVIDER_ID=1

# Timeouts in seconds: outside calls (Authentik, Proxmox, Nextcloud, aweful-proxy, Zulip, the Quotient login), and
# the error webhook's post
HTTPX_DEFAULT_TIMEOUT=10
DISCORD_WEBHOOK_TIMEOUT=5

# Webhook for 500 error alerts (a Discord channel's Integrations > Webhooks); must be https://; empty = off.
# Works without the Discord bot.
DISCORD_ERROR_WEBHOOK_URL=

# Where the worker and the chat process write the heartbeats `python -m core.health` reads. The default is a
# directory the image creates; for a plain run, point it at a writable directory.
# BOT_HEARTBEAT_DIR=/app/run/heartbeat

# ---------------------------------------------------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------------------------------------------------
# Chat: set DISCORD_BOT_TOKEN for Discord, the ZULIP_* trio below for Zulip, or both. Any value here configures
# Discord, so leave it empty for Zulip only. The chat process (`docker compose --profile chat up`) runs the bot when
# it is set; web and the worker read it too, to queue Discord work.
DISCORD_BOT_TOKEN=
# Discord IDs (right-click > Copy ID with Developer Mode on). Each must be a number; 0 means not configured, which
# turns off whatever needs it (the bot logs the unset ones at startup and posts them to the ops log channel).
# Competition server, where roles are synced to
DISCORD_GUILD_ID=0
# The volunteer server, where staff can only /link their accounts; roles live in the competition server and come
# from Authentik groups
VOLUNTEER_GUILD_ID=0
# Channels in the competition server: ops log, staff ticket queue, announcements, the ticket panel (welcome/rules)
# and the link-only panel
DISCORD_LOG_CHANNEL_ID=0
DISCORD_TICKET_QUEUE_CHANNEL_ID=0
DISCORD_ANNOUNCEMENT_CHANNEL_ID=0
DISCORD_WELCOME_CHANNEL_ID=0
DISCORD_LINK_CHANNEL_ID=0
# Authentik group to Discord role mappings
BLUETEAM_ROLE_ID=0
BLACKTEAM_ROLE_ID=0
WHITETEAM_ROLE_ID=0
ORANGETEAM_ROLE_ID=0
REDTEAM_ROLE_ID=0
GOLDTEAM_ROLE_ID=0
# Name of a competition server role that may talk in every team category beside the guest roles; empty = none
DISCORD_SERVER_OWNER_ROLE="ECL Server Owners"
# True forces the bot to sync its slash commands at startup; otherwise it syncs only when they changed
SYNC_COMMANDS=

# ---------------------------------------------------------------------------------------------------------------------
# Zulip
# ---------------------------------------------------------------------------------------------------------------------
# The chat process runs its Zulip runner when all three are set; set them for web and the worker too, which queue
# Zulip notices only then. ZULIP_SITE must be https://. Subscribe the bot to every team stream, and let it see
# senders' real emails (realm email visibility that includes it, or an admin bot): a reply counts only when its
# sender's email matches a portal account that may write to the ticket.
ZULIP_SITE=
ZULIP_BOT_EMAIL=
ZULIP_API_KEY=
# Streams: each team's ({number} pattern), the staff ticket alerts', announcements', and ops' stream and topic
ZULIP_TEAM_STREAM=team{number:02d}
ZULIP_STAFF_STREAM=tickets
ZULIP_ANNOUNCEMENTS_STREAM=announcements
ZULIP_OPS_STREAM=ops
ZULIP_OPS_TOPIC=ops
# User groups a new ticket mentions: a team's ({number} pattern, such as "Team {number:02d}") and staff's; empty = none
ZULIP_TEAM_MENTION=
ZULIP_STAFF_MENTION=

# ---------------------------------------------------------------------------------------------------------------------
# Region names
# ---------------------------------------------------------------------------------------------------------------------
# Page titles; defaults to "<ORG_SHORT_NAME> Portal"
SITE_NAME="ECL Portal"
# Permissions come from Authentik groups (web/core/permission_constants.py PERMISSION_MAP): PORTAL_ADMIN_GROUP
# (everything), and PORTAL_GROUP_PREFIX plus GoldTeam, WhiteTeam, WhiteTeam_Lead, OrangeTeam, OrangeTeam_Lead, RedTeam,
# Ticketing_Admin and Ticketing_Support; PORTAL_GROUP_PREFIX plus BlackTeam only grants its Discord role (settings.py
# GROUP_ROLE_MAPPING). PORTAL_ADMIN_GROUP defaults to PORTAL_GROUP_PREFIX plus Admin.
PORTAL_GROUP_PREFIX=Portal_
PORTAL_ADMIN_GROUP=Portal_Admin
# A new team's Authentik group, a str.format pattern using {number}; defaults to PORTAL_GROUP_PREFIX plus
# BlueTeam{number:02d}. A team keeps the group it was created with (editable on the team).
# TEAM_GROUP_PATTERN=Portal_BlueTeam{number:02d}
# A team's Authentik accounts; {number} stands for the team's two-digit number. With no regular expression operator
# it names the team's one shared account (team{number}: team01, team02, ...); otherwise the team's accounts are the
# members of its group whose username fully matches it (team{number}[a-i] gives each team nine), and the portal's
# password resets are off.
TEAM_ACCOUNT_PATTERN=team{number}
# Highest team number
MAX_TEAMS=50
